[Unit]
Description=AILA Trading Bot Web Interface
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/aila
Environment="PATH=/opt/aila/venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/opt/aila/venv/bin/python -m aila.scripts.run_web
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
