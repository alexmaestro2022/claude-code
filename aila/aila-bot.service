[Unit]
Description=AILA Trading Bot Web Interface
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/user/claude-code/aila
Environment="PATH=/home/user/claude-code/aila/.venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/user/claude-code/aila/.venv/bin/python -m api.main
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
