# AILA Configuration
# Copy this file to .env and fill in your values

# ===========================================
# Application Settings
# ===========================================
ENV=development                    # development | production
DEBUG=false
LOG_LEVEL=INFO

# ===========================================
# Bybit API Credentials
# ===========================================
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here
BYBIT_TESTNET=true                 # Use testnet for testing
BYBIT_ACCOUNT_TYPE=futures         # spot | futures

# ===========================================
# Strategy Settings
# ===========================================
STRATEGY_TIMEFRAME=1h
STRATEGY_EMA_ENABLED=true
STRATEGY_EMA_PERIOD=200

# SuperTrend 1 (Slow)
STRATEGY_ST1_PERIOD=12
STRATEGY_ST1_MULTIPLIER=3.0

# SuperTrend 2 (Medium)
STRATEGY_ST2_PERIOD=11
STRATEGY_ST2_MULTIPLIER=2.0

# SuperTrend 3 (Fast)
STRATEGY_ST3_PERIOD=10
STRATEGY_ST3_MULTIPLIER=1.0

# ===========================================
# Risk Management
# ===========================================
RISK_SL_MODE=supertrend_line       # supertrend_line | fixed_percent | atr
RISK_SL_SUPERTREND_LINE=2          # 1, 2, or 3
RISK_SL_FIXED_PERCENT=2.0
RISK_TP_MODE=risk_ratio            # risk_ratio | fixed_percent | multi_target
RISK_TP_RISK_RATIO=2.0
RISK_RISK_PER_TRADE=2.0            # % of balance per trade
RISK_MAX_POSITION_PERCENT=20.0
RISK_MAX_OPEN_POSITIONS=3
RISK_TRAILING_ENABLED=true
RISK_TRAILING_ACTIVATION=1.0
RISK_TRAILING_STEP=0.5
RISK_MAX_DAILY_LOSS_PERCENT=5.0
RISK_MAX_DRAWDOWN_PERCENT=15.0

# ===========================================
# Futures Settings
# ===========================================
FUTURES_DEFAULT_LEVERAGE=10
FUTURES_LEVERAGE_MODE=cross        # cross | isolated

# ===========================================
# Database (Optional - for PostgreSQL)
# ===========================================
DB_TYPE=sqlite                     # sqlite | postgresql
DB_PATH=./data/aila.db
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=aila
# DB_USER=aila
# DB_PASSWORD=your_db_password

# ===========================================
# Telegram Notifications (Optional)
# ===========================================
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ===========================================
# Web Dashboard (Optional)
# ===========================================
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_DEBUG=false

# ===========================================
# Security
# ===========================================
SECRET_KEY=change-this-to-a-random-secret-key
ENCRYPTION_KEY=change-this-to-a-random-encryption-key
